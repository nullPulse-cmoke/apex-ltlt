# ===== APEX Security & Git Ignore Configuration =====

# Environment variables & secrets (CRITICAL)
.env
.env*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keys, certificates, and credentials (CRITICAL)
*.pem
*.key
*.p12
*.crt
*.cer
*.pfx
*.asc
id_rsa*
id_ed25519*
id_dsa*

# Local SQLite databases & dumps (CRITICAL)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.dump
prisma/*.db

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Build outputs
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
/coverage

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS & Temp Files
.DS_Store
Thumbs.db

# Local temp configs and credentials
/volunteers_messages.txt
/nginx-default

# Vercel
.vercel
